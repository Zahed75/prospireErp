# ==========================================
# Sysco Odoo Environment Configuration
# ==========================================

# Database Configuration
DB_USER=odoo
DB_PASSWORD=prospire@2@26
DB_NAME=prospire_hq

# Odoo Ports
# 8069/8071/8072/8073 are used by other ERPs on this VPS, so use alternative ports.
ODOO_PORT=8070
LONGPOLLING_PORT=8074

# Admin Credentials (used by entrypoint and cron)
ADMIN_LOGIN=prospirenext@gmail.com
ADMIN_PASSWORD=prospire@2@26

# Site URLs (used by entrypoint and cron)
BASE_URL=https://edu.prospirenext.com
WEBSITE_DOMAIN=edu.prospirenext.com

# SMTP Configuration (used by post_init_hook and Odoo mail)
SMTP_USER=prospirenext@gmail.com
SMTP_PASSWORD=replace-with-a-16-character-gmail-app-password

# VexaNext company mail (optional but recommended — fixes Vexa mail landing
# in spam). Create a Gmail app password for vexanext@gmail.com (Google
# account → Security → 2FA → App passwords). Odoo then sends VexaNext mail
# authenticated AS vexanext@gmail.com instead of through the Prospire login.
VEXA_SMTP_USER=vexanext@gmail.com
VEXA_SMTP_PASSWORD=replace-with-16-char-app-password-for-vexanext

# Reply-To catchall domain. Leave EMPTY for Gmail-SMTP setups (replies go to
# the sender). Only set a real domain if you host its mail and created the
# catchall alias mailbox (e.g. catchall@prospirenext.com).
MAIL_CATCHALL_DOMAIN=

# Production Example:
# DB_USER=odoo
# DB_PASSWORD=prospire@2@26
# DB_NAME=prospire_hq
# ODOO_PORT=8070
# LONGPOLLING_PORT=8074
# ADMIN_LOGIN=prospirenext@gmail.com
# ADMIN_PASSWORD=prospire@2@26
# BASE_URL=https://edu.prospirenext.com
# WEBSITE_DOMAIN=edu.prospirenext.com
# SMTP_USER=prospirenext@gmail.com
# SMTP_PASSWORD=replace-with-a-16-character-gmail-app-password

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- CUSTOM LOGIN PAGE — PROSPIRE NEXT LEARNING HUB                 -->
    <!-- ============================================================ -->
    <!--
        web.login renders the auth form inside web.login_layout via
        t-out="0". We replace the layout's inner structure with our
        two-column design and let the native form (csrf_token, login,
        password, db selector, oauth, reset-password) flow through
        untouched inside .prospire-form-container.

        The password show/hide toggle is handled by Odoo's native
        web.show_password interaction — no custom JS is required.
    -->

    <!-- Website installed: replace the website.layout call it injects -->
    <template id="garshoub_login_layout"
              inherit_id="web.login_layout"
              name="Prospire Next Login"
              priority="30">

        <xpath expr="//t[@t-call='website.layout']" position="replace">
            <t t-call="web.frontend_layout">
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                <t t-set="body_classname" t-value="'prospire-login-page'"/>

                <link rel="stylesheet" href="/prospire_login/static/src/css/prospire_login.css"/>

                <div class="prospire-login-shell">

                    <!-- Left: brand / marketing -->
                    <aside class="prospire-brand-panel">
                        <div class="prospire-brand-top">
                            <img class="prospire-logo" src="/prospire_login/static/src/img/prospire-logo.svg" alt="Prospire Next" width="42" height="42"/>
                            <div class="prospire-brand-name">
                                <strong>PROSPIRE NEXT</strong>
                                <span>Learning Hub</span>
                            </div>
                        </div>

                        <div class="prospire-brand-body">
                            <span class="prospire-eyebrow">Learning Management Portal</span>
                            <h1 class="prospire-headline">
                                Welcome to
                                <span class="prospire-headline-gradient">Prospire Next</span>
                                Learning Hub
                            </h1>
                            <p class="prospire-lead">Manage courses, enrollments, students and educators in one central platform.</p>

                            <ul class="prospire-features">
                                <li class="prospire-feature">
                                    <span class="prospire-feature-icon"><img src="/prospire_login/static/src/img/smart-learning.svg" alt="" width="22" height="22"/></span>
                                    <div>
                                        <strong>Smart Learning</strong>
                                        <span>Interactive courses and personalized learning paths</span>
                                    </div>
                                </li>
                                <li class="prospire-feature">
                                    <span class="prospire-feature-icon"><img src="/prospire_login/static/src/img/manage-easily.svg" alt="" width="22" height="22"/></span>
                                    <div>
                                        <strong>Manage Easily</strong>
                                        <span>Streamline students, educators and course management</span>
                                    </div>
                                </li>
                                <li class="prospire-feature">
                                    <span class="prospire-feature-icon"><img src="/prospire_login/static/src/img/track-progress.svg" alt="" width="22" height="22"/></span>
                                    <div>
                                        <strong>Track Progress</strong>
                                        <span>Real-time analytics and performance insights</span>
                                    </div>
                                </li>
                            </ul>
                        </div>

                        <div class="prospire-hero">
                            <img src="/prospire_login/static/src/img/prospire-hero.svg" alt="Prospire Next learning illustration"/>
                        </div>
                    </aside>

                    <!-- Right: login card -->
                    <main class="prospire-login-panel">
                        <div class="prospire-login-card">
                            <div class="prospire-card-brand">
                                <img class="prospire-logo" src="/prospire_login/static/src/img/prospire-logo.svg" alt="Prospire Next" width="44" height="44"/>
                                <div class="prospire-brand-name">
                                    <strong>PROSPIRE NEXT</strong>
                                    <span>Learning Hub</span>
                                </div>
                            </div>

                            <h2 class="prospire-card-title">Welcome Back</h2>
                            <p class="prospire-card-subtitle">Sign in to continue to Prospire Next Learning Hub</p>

                            <div class="prospire-form-container">
                                <t t-out="0"/>
                            </div>

                            <p class="prospire-card-footer">© Prospire Next Learning Hub. All rights reserved.</p>
                        </div>
                    </main>

                </div>
            </t>
        </xpath>

    </template>

    <!-- Fallback: same layout when the website module is NOT installed -->
    <template id="garshoub_login_layout_base"
              inherit_id="web.login_layout"
              name="Prospire Next Login Base"
              priority="1">

        <xpath expr="//t[@t-call='web.frontend_layout']" position="replace">
            <t t-call="web.frontend_layout">
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                <t t-set="body_classname" t-value="'prospire-login-page'"/>

                <link rel="stylesheet" href="/prospire_login/static/src/css/prospire_login.css"/>

                <div class="prospire-login-shell">

                    <aside class="prospire-brand-panel">
                        <div class="prospire-brand-top">
                            <img class="prospire-logo" src="/prospire_login/static/src/img/prospire-logo.svg" alt="Prospire Next" width="42" height="42"/>
                            <div class="prospire-brand-name">
                                <strong>PROSPIRE NEXT</strong>
                                <span>Learning Hub</span>
                            </div>
                        </div>

                        <div class="prospire-brand-body">
                            <span class="prospire-eyebrow">Learning Management Portal</span>
                            <h1 class="prospire-headline">
                                Welcome to
                                <span class="prospire-headline-gradient">Prospire Next</span>
                                Learning Hub
                            </h1>
                            <p class="prospire-lead">Manage courses, enrollments, students and educators in one central platform.</p>

                            <ul class="prospire-features">
                                <li class="prospire-feature">
                                    <span class="prospire-feature-icon"><img src="/prospire_login/static/src/img/smart-learning.svg" alt="" width="22" height="22"/></span>
                                    <div>
                                        <strong>Smart Learning</strong>
                                        <span>Interactive courses and personalized learning paths</span>
                                    </div>
                                </li>
                                <li class="prospire-feature">
                                    <span class="prospire-feature-icon"><img src="/prospire_login/static/src/img/manage-easily.svg" alt="" width="22" height="22"/></span>
                                    <div>
                                        <strong>Manage Easily</strong>
                                        <span>Streamline students, educators and course management</span>
                                    </div>
                                </li>
                                <li class="prospire-feature">
                                    <span class="prospire-feature-icon"><img src="/prospire_login/static/src/img/track-progress.svg" alt="" width="22" height="22"/></span>
                                    <div>
                                        <strong>Track Progress</strong>
                                        <span>Real-time analytics and performance insights</span>
                                    </div>
                                </li>
                            </ul>
                        </div>

                        <div class="prospire-hero">
                            <img src="/prospire_login/static/src/img/prospire-hero.svg" alt="Prospire Next learning illustration"/>
                        </div>
                    </aside>

                    <main class="prospire-login-panel">
                        <div class="prospire-login-card">
                            <div class="prospire-card-brand">
                                <img class="prospire-logo" src="/prospire_login/static/src/img/prospire-logo.svg" alt="Prospire Next" width="44" height="44"/>
                                <div class="prospire-brand-name">
                                    <strong>PROSPIRE NEXT</strong>
                                    <span>Learning Hub</span>
                                </div>
                            </div>

                            <h2 class="prospire-card-title">Welcome Back</h2>
                            <p class="prospire-card-subtitle">Sign in to continue to Prospire Next Learning Hub</p>

                            <div class="prospire-form-container">
                                <t t-out="0"/>
                            </div>

                            <p class="prospire-card-footer">© Prospire Next Learning Hub. All rights reserved.</p>
                        </div>
                    </main>

                </div>
            </t>
        </xpath>

    </template>

</odoo>
